cmake_minimum_required(VERSION 3.26)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${root}/dotnet-version.cmake")
include("${root}/scripts/dotnet/common.cmake")
if(NOT DEFINED TRIPLET)
  set(TRIPLET x64-windows-star)
endif()
if(NOT TRIPLET STREQUAL "x64-windows-star")
  message(FATAL_ERROR "This first CoreCLR pipeline supports only x64-windows-star")
endif()
if(DEFINED CONFIGURATION AND NOT CONFIGURATION STREQUAL "Release")
  message(FATAL_ERROR "This CoreCLR pipeline currently builds Release only")
endif()
if(NOT DEFINED JOBS)
  set(JOBS 4)
endif()
if(NOT JOBS MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "JOBS must be a positive integer")
endif()
if(PRINT_ARGS)
  message(STATUS "${STAR_DOTNET_TAG} @ ${STAR_DOTNET_REVISION}")
  message(STATUS "build.cmd -subset ${STAR_DOTNET_SUBSETS} -configuration Release -arch x64 -os windows -ci /p:VersionSuffix=${STAR_DOTNET_VERSION_SUFFIX} /p:GenerateInstallers=false /p:GenerateVSInsertionPackages=false /p:SkipInstallerBuild=true /p:IncludeSourceRevisionInInformationalVersion=true /p:SourceRevisionId=${STAR_DOTNET_REVISION} /maxcpucount:${JOBS}")
  return()
endif()
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "Windows CoreCLR requires a Windows x64 build host")
endif()
find_program(GIT_EXECUTABLE git REQUIRED)
find_program(POWERSHELL_EXECUTABLE powershell REQUIRED)
set(work "${root}/out/dotnet")
set(source "${work}/source")
set(output "${work}/${TRIPLET}/Release")
file(MAKE_DIRECTORY "${output}")
file(LOCK "${work}/build.lock" GUARD PROCESS TIMEOUT 0)
if(NOT EXISTS "${source}/.git")
  star_dotnet_run("${root}" "${GIT_EXECUTABLE}" clone --config core.autocrlf=false
    --config core.longpaths=true --depth 1 --branch "${STAR_DOTNET_TAG}"
    https://github.com/dotnet/runtime.git "${source}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD
  OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT revision STREQUAL STAR_DOTNET_REVISION)
  message(FATAL_ERROR "CoreCLR checkout differs from the pin: ${revision}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" status --porcelain --untracked-files=normal
  OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(changes)
  message(FATAL_ERROR "CoreCLR checkout has local changes; use a clean pinned checkout:\n${changes}")
endif()
message(STATUS "Building CoreCLR; log: ${work}/source-build.log")
execute_process(COMMAND "${POWERSHELL_EXECUTABLE}" -NoProfile -ExecutionPolicy Bypass
  -File "${root}/scripts/dotnet/build-windows.ps1" -Source "${source}"
  -VersionSuffix "${STAR_DOTNET_VERSION_SUFFIX}" -Revision "${STAR_DOTNET_REVISION}"
  -Subsets "${STAR_DOTNET_SUBSETS}" -Jobs "${JOBS}"
  OUTPUT_FILE "${work}/source-build.log" ERROR_FILE "${work}/source-build.log" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "CoreCLR source build failed (${result}); see ${work}/source-build.log")
endif()

# Extract the upstream runtime distribution instead of guessing a list of BCL DLLs.
set(runtime_archive "${source}/artifacts/packages/Release/Shipping/dotnet-runtime-${STAR_DOTNET_RUNTIME_VERSION}-win-x64.zip")
star_dotnet_require_file("${runtime_archive}")
set(host "${source}/artifacts/bin/win-x64.Release/corehost")
set(base "star-dotnet-${STAR_DOTNET_VERSION}-${TRIPLET}-release-sdk")
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef attempt)
set(stage "${output}/staging-${attempt}")
set(sdk "${stage}/${base}")
file(MAKE_DIRECTORY "${sdk}/runtime" "${sdk}/include" "${sdk}/bin" "${sdk}/lib"
  "${sdk}/share/dotnet" "${sdk}/provenance")
file(ARCHIVE_EXTRACT INPUT "${runtime_archive}" DESTINATION "${sdk}/runtime")
foreach(header nethost.h hostfxr.h coreclr_delegates.h host_error_codes.h)
  star_dotnet_require_file("${host}/${header}")
  file(COPY_FILE "${host}/${header}" "${sdk}/include/${header}")
endforeach()
foreach(binary nethost.dll nethost.lib)
  star_dotnet_require_file("${host}/${binary}")
endforeach()
file(COPY_FILE "${host}/nethost.dll" "${sdk}/bin/nethost.dll")
file(COPY_FILE "${host}/nethost.lib" "${sdk}/lib/nethost.lib")
file(COPY_FILE "${source}/LICENSE.TXT" "${sdk}/LICENSE.TXT")
file(COPY_FILE "${source}/THIRD-PARTY-NOTICES.TXT" "${sdk}/THIRD-PARTY-NOTICES.TXT")
file(COPY_FILE "${source}/global.json" "${sdk}/provenance/runtime-global.json")
file(COPY_FILE "${root}/dotnet-version.cmake" "${sdk}/provenance/dotnet-version.cmake")
configure_file("${root}/scripts/dotnet/StarDotNetConfig.cmake.in"
  "${sdk}/share/dotnet/StarDotNetConfig.cmake" @ONLY)
file(WRITE "${sdk}/provenance/build.json"
  "{\n  \"schemaVersion\": 1,\n  \"upstreamVersion\": \"${STAR_DOTNET_VERSION}\",\n  \"sourceTag\": \"${STAR_DOTNET_TAG}\",\n  \"sourceRevision\": \"${revision}\",\n  \"runtimeVersion\": \"${STAR_DOTNET_RUNTIME_VERSION}\",\n  \"triplet\": \"${TRIPLET}\",\n  \"configuration\": \"Release\",\n  \"subsets\": \"${STAR_DOTNET_SUBSETS}\",\n  \"consumerSdk\": \"${STAR_DOTNET_SDK_VERSION}\",\n  \"consumerSdkSha512\": \"${STAR_DOTNET_SDK_SHA512}\"\n}\n")
file(GLOB_RECURSE payload RELATIVE "${sdk}" LIST_DIRECTORIES false "${sdk}/*")
list(SORT payload)
set(checksums "")
foreach(path IN LISTS payload)
  file(SHA256 "${sdk}/${path}" hash)
  string(APPEND checksums "${hash}  ${path}\n")
endforeach()
file(WRITE "${sdk}/provenance/files.sha256" "${checksums}")

# Validate an extracted archive at a path containing spaces before publication.
set(candidate "${stage}/${base}.zip")
star_dotnet_run("${stage}" "${CMAKE_COMMAND}" -E tar cf "${candidate}" --format=zip "${base}")
set(relocated "${stage}/relocated sdk")
file(ARCHIVE_EXTRACT INPUT "${candidate}" DESTINATION "${relocated}")
star_dotnet_acquire_sdk("${work}" compiler)
star_dotnet_run("${root}" "${CMAKE_COMMAND}" "-DSTAR_SDK_ROOT=${relocated}/${base}"
  "-DDOTNET_EXECUTABLE=${compiler}" "-DBUILD_DIR=${stage}/consumer"
  -P "${root}/scripts/dotnet/validate.cmake")
file(COPY_FILE "${candidate}" "${output}/${base}.zip" ONLY_IF_DIFFERENT)
file(SHA256 "${output}/${base}.zip" archive_hash)
file(WRITE "${output}/${base}.zip.sha256" "${archive_hash}  ${base}.zip\n")
message(STATUS "Validated CoreCLR SDK: ${output}/${base}.zip")
