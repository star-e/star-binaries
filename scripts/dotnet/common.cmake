function(star_dotnet_run directory)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}"
    COMMAND_ECHO STDOUT COMMAND_ERROR_IS_FATAL ANY)
endfunction()

function(star_dotnet_require_file path)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR "Required .NET artifact is missing: ${path}")
  endif()
endfunction()

function(star_dotnet_verify_payload sdk)
  file(STRINGS "${sdk}/provenance/files.sha256" checksums)
  set(listed_files "provenance/files.sha256")
  foreach(line IN LISTS checksums)
    string(LENGTH "${line}" length)
    if(length LESS 67)
      message(FATAL_ERROR "Invalid checksum entry: ${line}")
    endif()
    string(SUBSTRING "${line}" 0 64 expected_hash)
    string(SUBSTRING "${line}" 66 -1 path)
    if(NOT expected_hash MATCHES "^[0-9a-f]+$" OR IS_ABSOLUTE "${path}" OR
       path MATCHES "(^|/)[.][.](/|$)" OR path MATCHES "\\\\")
      message(FATAL_ERROR "Invalid checksum entry: ${line}")
    endif()
    star_dotnet_require_file("${sdk}/${path}")
    file(SHA256 "${sdk}/${path}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "SDK file checksum mismatch: ${path}")
    endif()
    list(APPEND listed_files "${path}")
  endforeach()
  file(GLOB_RECURSE actual_files RELATIVE "${sdk}" LIST_DIRECTORIES false "${sdk}/*")
  list(SORT listed_files)
  list(SORT actual_files)
  if(NOT listed_files STREQUAL actual_files)
    message(FATAL_ERROR "SDK contains unlisted or duplicate files")
  endif()
endfunction()

function(star_dotnet_build_profile_tool compiler directory result)
  file(MAKE_DIRECTORY "${directory}/source")
  foreach(file Program.cs ProfileTool.csproj)
    configure_file("${root}/scripts/dotnet/profile-tool/${file}" "${directory}/source/${file}" COPYONLY)
  endforeach()
  file(WRITE "${directory}/source/NuGet.Config"
    "<configuration><packageSources><clear /></packageSources></configuration>\n")
  file(WRITE "${directory}/source/global.json"
    "{\"sdk\":{\"version\":\"${STAR_DOTNET_SDK_VERSION}\",\"rollForward\":\"disable\",\"allowPrerelease\":true}}\n")
  star_dotnet_run("${directory}/source" "${CMAKE_COMMAND}" -E env --unset=LIB --unset=LIBPATH
    DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_GENERATE_ASPNET_CERTIFICATE=false DOTNET_ADD_GLOBAL_TOOLS_TO_PATH=false
    "DOTNET_CLI_HOME=${directory}/dotnet-home" "${compiler}" build ProfileTool.csproj -c Release
    --output "${directory}/bin" --nologo)
  set(${result} "${directory}/bin/ProfileTool.dll" PARENT_SCOPE)
endfunction()

function(star_dotnet_acquire_sdk work result)
  file(MAKE_DIRECTORY "${work}/tools")
  file(LOCK "${work}/tools/sdk.lock" GUARD FUNCTION TIMEOUT 0)
  set(archive "${work}/downloads/${dotnet_sdk_archive}")
  set(compiler "${work}/tools/dotnet-sdk-${STAR_DOTNET_SDK_VERSION}-${dotnet_rid}")
  if(NOT EXISTS "${compiler}/sdk/${STAR_DOTNET_SDK_VERSION}/dotnet.dll")
    file(MAKE_DIRECTORY "${work}/downloads" "${compiler}")
    if(EXISTS "${archive}")
      file(SHA512 "${archive}" actual_hash)
      if(NOT actual_hash STREQUAL STAR_DOTNET_SDK_SHA512)
        message(FATAL_ERROR "SDK checksum mismatch: ${archive}")
      endif()
    else()
      file(DOWNLOAD "${STAR_DOTNET_SDK_URL}" "${archive}.partial"
        EXPECTED_HASH "SHA512=${STAR_DOTNET_SDK_SHA512}" TLS_VERIFY ON SHOW_PROGRESS)
      file(RENAME "${archive}.partial" "${archive}")
    endif()
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${compiler}")
  endif()
  file(WRITE "${compiler}/global.json"
    "{\"sdk\":{\"version\":\"${STAR_DOTNET_SDK_VERSION}\",\"rollForward\":\"disable\",\"allowPrerelease\":true}}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env DOTNET_CLI_TELEMETRY_OPTOUT=1
    DOTNET_GENERATE_ASPNET_CERTIFICATE=false DOTNET_ADD_GLOBAL_TOOLS_TO_PATH=false
    "${compiler}/${dotnet_executable}" --version WORKING_DIRECTORY "${compiler}"
    OUTPUT_VARIABLE actual_version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT actual_version STREQUAL STAR_DOTNET_SDK_VERSION)
    message(FATAL_ERROR "Unexpected consumer SDK: ${actual_version}")
  endif()
  set(${result} "${compiler}/${dotnet_executable}" PARENT_SCOPE)
endfunction()
