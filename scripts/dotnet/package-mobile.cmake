# Invoked only after the pinned source build succeeds. Keep the upstream runtime
# pack intact, including its BCL and Apple composite R2R image.
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(pack_name "${dotnet_package_id}.${STAR_DOTNET_RUNTIME_VERSION}.nupkg")
set(pack "${source}/artifacts/packages/Release/Shipping/${pack_name}")
star_dotnet_require_file("${pack}")
star_dotnet_run("${root}" "${Python3_EXECUTABLE}" "${root}/scripts/dotnet/validate-mobile-pack.py"
  "${pack}" --rid "${dotnet_rid}" --version "${STAR_DOTNET_RUNTIME_VERSION}")

set(base "star-dotnet-${STAR_DOTNET_VERSION}-${TRIPLET}-release-runtime-pack")
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef attempt)
set(stage "${output}/staging-${attempt}")
set(sdk "${stage}/${base}")
file(MAKE_DIRECTORY "${sdk}/packs" "${sdk}/include" "${sdk}/provenance")
file(COPY_FILE "${pack}" "${sdk}/packs/${pack_name}")
file(COPY_FILE "${source}/src/coreclr/hosts/inc/coreclrhost.h" "${sdk}/include/coreclrhost.h")
file(COPY_FILE "${source}/src/native/corehost/coreclr_delegates.h" "${sdk}/include/coreclr_delegates.h")
foreach(file LICENSE.TXT THIRD-PARTY-NOTICES.TXT)
  file(COPY_FILE "${source}/${file}" "${sdk}/${file}")
endforeach()
file(COPY_FILE "${source}/global.json" "${sdk}/provenance/runtime-global.json")
file(COPY_FILE "${root}/dotnet-version.cmake" "${sdk}/provenance/dotnet-version.cmake")
file(WRITE "${sdk}/provenance/build.json"
  "{\n  \"schemaVersion\": 1,\n  \"upstreamVersion\": \"${STAR_DOTNET_VERSION}\",\n  \"sourceTag\": \"${STAR_DOTNET_TAG}\",\n  \"sourceRevision\": \"${revision}\",\n  \"runtimeVersion\": \"${STAR_DOTNET_RUNTIME_VERSION}\",\n  \"triplet\": \"${TRIPLET}\",\n  \"rid\": \"${dotnet_rid}\",\n  \"configuration\": \"Release\",\n  \"runtimeFlavor\": \"CoreCLR\",\n  \"executionMode\": \"${dotnet_execution}\",\n  \"subsets\": \"${dotnet_subsets}\",\n  \"artifactKind\": \"runtime-pack\",\n  \"validation\": \"package-content-and-native-target\",\n  \"runtimeTested\": false\n}\n")
file(GLOB_RECURSE payload RELATIVE "${sdk}" LIST_DIRECTORIES false "${sdk}/*")
list(SORT payload)
set(checksums "")
foreach(path IN LISTS payload)
  file(SHA256 "${sdk}/${path}" hash)
  string(APPEND checksums "${hash}  ${path}\n")
endforeach()
file(WRITE "${sdk}/provenance/files.sha256" "${checksums}")
set(candidate "${stage}/${base}.tar.gz")
star_dotnet_run("${stage}" "${CMAKE_COMMAND}" -E tar czf "${candidate}" --format=gnutar "${base}")
set(relocated "${stage}/relocated runtime pack/${base}")
file(ARCHIVE_EXTRACT INPUT "${candidate}" DESTINATION "${stage}/relocated runtime pack")
star_dotnet_verify_payload("${relocated}")
star_dotnet_run("${root}" "${Python3_EXECUTABLE}" "${root}/scripts/dotnet/validate-mobile-pack.py"
  "${relocated}/packs/${pack_name}" --rid "${dotnet_rid}" --version "${STAR_DOTNET_RUNTIME_VERSION}")
set(archive "${output}/${base}.tar.gz")
file(COPY_FILE "${candidate}" "${archive}" ONLY_IF_DIFFERENT)
file(SHA256 "${archive}" archive_hash)
file(WRITE "${archive}.sha256" "${archive_hash}  ${base}.tar.gz\n")
message(STATUS "CoreCLR mobile runtime pack: ${archive} (built and content-checked; runtime execution pending)")
