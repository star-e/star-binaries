# Target layout is shared by building, packaging and package-only validation.
if(NOT DEFINED TRIPLET)
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(TRIPLET arm64-osx-star)
  else()
    set(TRIPLET x64-windows-star)
  endif()
endif()
if(TRIPLET STREQUAL "x64-windows-star")
  set(dotnet_os windows)
  set(dotnet_arch x64)
  set(dotnet_rid win-x64)
  set(dotnet_archive_extension zip)
  set(dotnet_executable dotnet.exe)
  set(dotnet_nethost nethost.dll)
  set(dotnet_host_library nethost.lib)
  set(dotnet_build_entry build.cmd)
elseif(TRIPLET STREQUAL "arm64-osx-star")
  set(dotnet_os osx)
  set(dotnet_arch arm64)
  set(dotnet_rid osx-arm64)
  set(dotnet_archive_extension tar.gz)
  set(dotnet_executable dotnet)
  set(dotnet_nethost libnethost.dylib)
  set(dotnet_host_library libnethost.a)
  set(dotnet_build_entry build.sh)
else()
  message(FATAL_ERROR "Unsupported CoreCLR triplet: ${TRIPLET}")
endif()
set(dotnet_sdk_archive "dotnet-sdk-${STAR_DOTNET_SDK_VERSION}-${dotnet_rid}.${dotnet_archive_extension}")
set(STAR_DOTNET_SDK_URL "https://builds.dotnet.microsoft.com/dotnet/Sdk/${STAR_DOTNET_SDK_VERSION}/${dotnet_sdk_archive}")
set(STAR_DOTNET_SDK_SHA512 "${STAR_DOTNET_SDK_${dotnet_rid}_SHA512}")

function(star_dotnet_require_host)
  if(TRIPLET STREQUAL "x64-windows-star" AND CMAKE_HOST_WIN32)
    return()
  endif()
  if(TRIPLET STREQUAL "arm64-osx-star" AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    execute_process(COMMAND uname -m OUTPUT_VARIABLE architecture
      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(architecture STREQUAL "arm64")
      return()
    endif()
  endif()
  message(FATAL_ERROR "${TRIPLET} requires a matching native host (Windows x64 or macOS arm64)")
endfunction()
