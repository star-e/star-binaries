cmake_minimum_required(VERSION 3.26)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/dotnet-version.cmake")
include("${root}/scripts/dotnet/common.cmake")
include("${root}/scripts/dotnet/platform.cmake")
star_dotnet_require_host()
star_dotnet_require_file("${ARCHIVE}")
file(REAL_PATH "${ARCHIVE}" ARCHIVE)
get_filename_component(filename "${ARCHIVE}" NAME)
if(NOT DEFINED PROFILE)
  set(PROFILE full)
endif()
if(PROFILE STREQUAL "full")
  set(base "star-dotnet-${STAR_DOTNET_VERSION}-${TRIPLET}-release-sdk")
elseif(PROFILE STREQUAL "base")
  set(base "star-dotnet-${STAR_DOTNET_VERSION}-${TRIPLET}-release-base-sdk")
else()
  message(FATAL_ERROR "Unsupported archive PROFILE: ${PROFILE}")
endif()
if(NOT filename STREQUAL "${base}.${dotnet_archive_extension}")
  message(FATAL_ERROR "Unexpected CoreCLR archive name: ${filename}")
endif()
star_dotnet_require_file("${ARCHIVE}.sha256")
file(READ "${ARCHIVE}.sha256" checksum)
string(STRIP "${checksum}" checksum)
file(SHA256 "${ARCHIVE}" actual_hash)
if(NOT checksum STREQUAL "${actual_hash}  ${filename}")
  message(FATAL_ERROR "CoreCLR archive SHA256/name mismatch")
endif()
if(NOT DEFINED BUILD_DIR)
  set(BUILD_DIR "${root}/out/dotnet/package-validation/${TRIPLET}")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
file(MAKE_DIRECTORY "${BUILD_DIR}")
file(LOCK "${BUILD_DIR}/archive.lock" GUARD PROCESS TIMEOUT 0)
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef attempt)
set(stage "${BUILD_DIR}/attempt-${attempt}")
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${stage}/relocated sdk")
set(compiler_argument)
if(DEFINED DOTNET_EXECUTABLE)
  list(APPEND compiler_argument "-DDOTNET_EXECUTABLE=${DOTNET_EXECUTABLE}")
endif()
star_dotnet_run("${root}" "${CMAKE_COMMAND}" "-DTRIPLET=${TRIPLET}"
  "-DSTAR_SDK_ROOT=${stage}/relocated sdk/${base}" "-DBUILD_DIR=${stage}/consumer"
  "-DPROFILE=${PROFILE}" ${compiler_argument} -P "${root}/scripts/dotnet/validate.cmake")
file(WRITE "${stage}/validated.json"
  "{\"archive\":\"${filename}\",\"sha256\":\"${actual_hash}\",\"sourceRevision\":\"${STAR_DOTNET_REVISION}\",\"triplet\":\"${TRIPLET}\",\"profile\":\"${PROFILE}\"}\n")
message(STATUS "CoreCLR package validation passed; receipt: ${stage}/validated.json")
