cmake_minimum_required(VERSION 3.26)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/dotnet-version.cmake")
include("${root}/scripts/dotnet/common.cmake")
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "The Windows CoreCLR consumer requires a Windows host")
endif()
if(NOT IS_DIRECTORY "${STAR_SDK_ROOT}")
  message(FATAL_ERROR "Pass -DSTAR_SDK_ROOT=<extracted CoreCLR SDK>")
endif()
file(REAL_PATH "${STAR_SDK_ROOT}" STAR_SDK_ROOT)
set(manifest "${STAR_SDK_ROOT}/provenance/build.json")
star_dotnet_require_file("${manifest}")
file(READ "${manifest}" metadata)
foreach(field sourceRevision runtimeVersion triplet configuration consumerSdk)
  string(JSON "${field}" GET "${metadata}" "${field}")
endforeach()
if(NOT sourceRevision STREQUAL STAR_DOTNET_REVISION OR
   NOT runtimeVersion STREQUAL STAR_DOTNET_RUNTIME_VERSION OR
   NOT triplet STREQUAL "x64-windows-star" OR NOT configuration STREQUAL "Release" OR
   NOT consumerSdk STREQUAL STAR_DOTNET_SDK_VERSION)
  message(FATAL_ERROR "SDK provenance does not match the selected CoreCLR build")
endif()
file(STRINGS "${STAR_SDK_ROOT}/provenance/files.sha256" checksums)
set(listed_files "provenance/files.sha256")
foreach(line IN LISTS checksums)
  string(SUBSTRING "${line}" 0 64 expected_hash)
  string(SUBSTRING "${line}" 66 -1 path)
  if(NOT expected_hash MATCHES "^[0-9a-f]+$" OR IS_ABSOLUTE "${path}" OR
     path MATCHES "(^|/)[.][.](/|$)" OR path MATCHES "\\\\")
    message(FATAL_ERROR "Invalid checksum entry: ${line}")
  endif()
  star_dotnet_require_file("${STAR_SDK_ROOT}/${path}")
  file(SHA256 "${STAR_SDK_ROOT}/${path}" actual_hash)
  if(NOT actual_hash STREQUAL expected_hash)
    message(FATAL_ERROR "SDK file checksum mismatch: ${path}")
  endif()
  list(APPEND listed_files "${path}")
endforeach()
file(GLOB_RECURSE actual_files RELATIVE "${STAR_SDK_ROOT}" LIST_DIRECTORIES false "${STAR_SDK_ROOT}/*")
list(SORT listed_files)
list(SORT actual_files)
if(NOT listed_files STREQUAL actual_files)
  message(FATAL_ERROR "SDK contains unlisted or duplicate files")
endif()
if(NOT DEFINED BUILD_DIR)
  set(BUILD_DIR "${root}/out/dotnet/consumer")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
file(MAKE_DIRECTORY "${BUILD_DIR}")
file(LOCK "${BUILD_DIR}/validation.lock" GUARD PROCESS TIMEOUT 0)
if(NOT DEFINED DOTNET_EXECUTABLE)
  star_dotnet_acquire_sdk("${root}/out/dotnet" DOTNET_EXECUTABLE)
endif()
star_dotnet_run("${root}" "${CMAKE_COMMAND}" -S "${root}/tests/dotnet" -B "${BUILD_DIR}"
  -A x64 "-DSTAR_SDK_ROOT=${STAR_SDK_ROOT}" "-DDOTNET_EXECUTABLE=${DOTNET_EXECUTABLE}"
  "-DCONSUMER_SDK_VERSION=${STAR_DOTNET_SDK_VERSION}")
star_dotnet_run("${root}" "${CMAKE_COMMAND}" --build "${BUILD_DIR}" --config Release --parallel 2)
find_program(CTEST_EXECUTABLE ctest REQUIRED)
# Explicit root arguments plus disabled roll-forward prevent machine-runtime fallback.
star_dotnet_run("${root}" "${CMAKE_COMMAND}" -E env DOTNET_MULTILEVEL_LOOKUP=0
  DOTNET_ROLL_FORWARD=Disable DOTNET_CLI_TELEMETRY_OPTOUT=1
  "${CTEST_EXECUTABLE}" --test-dir "${BUILD_DIR}" -C Release --output-on-failure -V)
