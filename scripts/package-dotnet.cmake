cmake_minimum_required(VERSION 3.26)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${root}/dotnet-version.cmake")
include("${root}/scripts/dotnet/common.cmake")
if(NOT IS_DIRECTORY "${STAR_SDK_ROOT}")
  message(FATAL_ERROR "Pass -DSTAR_SDK_ROOT=<extracted full CoreCLR SDK>")
endif()
file(REAL_PATH "${STAR_SDK_ROOT}" STAR_SDK_ROOT)
file(READ "${STAR_SDK_ROOT}/provenance/build.json" metadata)
foreach(field sourceRevision runtimeVersion triplet configuration consumerSdk)
  string(JSON "${field}" GET "${metadata}" "${field}")
endforeach()
if(DEFINED TRIPLET AND NOT TRIPLET STREQUAL triplet)
  message(FATAL_ERROR "Input SDK target does not match TRIPLET")
endif()
set(TRIPLET "${triplet}")
include("${root}/scripts/dotnet/platform.cmake")
star_dotnet_require_host()
if(NOT sourceRevision STREQUAL STAR_DOTNET_REVISION OR
   NOT runtimeVersion STREQUAL STAR_DOTNET_RUNTIME_VERSION OR
   NOT configuration STREQUAL "Release" OR
   NOT consumerSdk STREQUAL STAR_DOTNET_SDK_VERSION)
  message(FATAL_ERROR "Input SDK provenance does not match the pinned build")
endif()
star_dotnet_verify_payload("${STAR_SDK_ROOT}")
if(NOT DEFINED PROFILE)
  set(PROFILE base)
endif()
if(NOT PROFILE STREQUAL "base")
  message(FATAL_ERROR "Only PROFILE=base is currently supported")
endif()
set(profile_file "${root}/scripts/dotnet/profiles/${PROFILE}.json")
star_dotnet_require_file("${profile_file}")
set(work "${root}/out/dotnet")
if(NOT DEFINED OUTPUT_DIR)
  set(OUTPUT_DIR "${work}/${TRIPLET}/Release")
endif()
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
file(RELATIVE_PATH output_relative "${STAR_SDK_ROOT}" "${OUTPUT_DIR}")
if(NOT IS_ABSOLUTE "${output_relative}" AND NOT output_relative MATCHES "^[.][.](/|$)")
  message(FATAL_ERROR "OUTPUT_DIR must be outside the input SDK")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(LOCK "${OUTPUT_DIR}/package-${PROFILE}.lock" GUARD PROCESS TIMEOUT 0)
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef attempt)
set(stage "${OUTPUT_DIR}/staging-${PROFILE}-${attempt}")
set(base "star-dotnet-${STAR_DOTNET_VERSION}-${TRIPLET}-release-${PROFILE}-sdk")
set(sdk "${stage}/${base}")
if(NOT DEFINED DOTNET_EXECUTABLE)
  star_dotnet_acquire_sdk("${work}" DOTNET_EXECUTABLE)
endif()
star_dotnet_build_profile_tool("${DOTNET_EXECUTABLE}" "${stage}/profile-tool" profile_tool)
star_dotnet_run("${root}" "${DOTNET_EXECUTABLE}" "${profile_tool}" pack
  "${profile_file}" "${STAR_SDK_ROOT}" "${sdk}")
file(GLOB_RECURSE payload RELATIVE "${sdk}" LIST_DIRECTORIES false "${sdk}/*")
list(SORT payload)
set(checksums "")
foreach(path IN LISTS payload)
  file(SHA256 "${sdk}/${path}" hash)
  string(APPEND checksums "${hash}  ${path}\n")
endforeach()
file(WRITE "${sdk}/provenance/files.sha256" "${checksums}")
set(candidate "${stage}/${base}.${dotnet_archive_extension}")
if(dotnet_archive_extension STREQUAL "zip")
  star_dotnet_run("${stage}" "${CMAKE_COMMAND}" -E tar cf "${candidate}" --format=zip "${base}")
else()
  star_dotnet_run("${stage}" "${CMAKE_COMMAND}" -E tar czf "${candidate}" --format=gnutar "${base}")
endif()
file(ARCHIVE_EXTRACT INPUT "${candidate}" DESTINATION "${stage}/relocated sdk")
star_dotnet_run("${root}" "${CMAKE_COMMAND}" "-DSTAR_SDK_ROOT=${stage}/relocated sdk/${base}"
  "-DPROFILE=${PROFILE}" "-DDOTNET_EXECUTABLE=${DOTNET_EXECUTABLE}" "-DPROFILE_TOOL=${profile_tool}"
  "-DBUILD_DIR=${stage}/consumer" -P "${root}/scripts/dotnet/validate.cmake")
star_dotnet_run("${root}" "${CMAKE_COMMAND}" "-DDOTNET_EXECUTABLE=${DOTNET_EXECUTABLE}"
  "-DPROFILE_TOOL=${profile_tool}" "-DSOURCE_SDK=${STAR_SDK_ROOT}"
  "-DSELECTED_SDK=${stage}/relocated sdk/${base}" "-DAPPLICATIONS=${stage}/consumer/managed"
  "-DBUILD_DIR=${stage}/selection-tests" -P "${root}/tests/dotnet/profile-selection.cmake")
set(archive "${OUTPUT_DIR}/${base}.${dotnet_archive_extension}")
file(COPY_FILE "${candidate}" "${archive}" ONLY_IF_DIFFERENT)
file(SHA256 "${archive}" archive_hash)
file(WRITE "${archive}.sha256" "${archive_hash}  ${base}.${dotnet_archive_extension}\n")
message(STATUS "Validated ${PROFILE} CoreCLR SDK: ${archive}")
