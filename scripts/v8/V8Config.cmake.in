get_filename_component(_v8_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(V8_VERSION "@STAR_V8_VERSION@")
set(V8_STAR_TRIPLET "@TRIPLET@")
set(V8_LINKAGE "@v8_linkage@")
set(V8_JITLESS @v8_jitless@)
set(V8_RUNTIME_FILES_RELEASE)
set(V8_RUNTIME_FILES_DEBUG)
if(V8_LINKAGE STREQUAL "SHARED")
  foreach(_config RELEASE DEBUG)
    set(_dir "${_v8_root}/@runtime_subdir@")
    if(_config STREQUAL "DEBUG")
      set(_dir "${_v8_root}/debug/@runtime_subdir@")
    endif()
    file(GLOB V8_RUNTIME_FILES_${_config} "${_dir}/*@runtime_suffix@")
  endforeach()
endif()
if(NOT TARGET V8::V8)
  if(V8_LINKAGE STREQUAL "STATIC")
    set(_components V8)
  else()
    set(_components V8 Platform Base)
  endif()
  foreach(_component IN LISTS _components)
    if(V8_LINKAGE STREQUAL "STATIC")
      set(_filename libv8_monolith.a)
    elseif(_component STREQUAL "V8")
      set(_filename "@library_prefix@v8@library_suffix@")
    elseif(_component STREQUAL "Platform")
      set(_filename "@library_prefix@v8_libplatform@library_suffix@")
    else()
      set(_filename "@library_prefix@v8_libbase@library_suffix@")
    endif()
    add_library(V8::${_component} @v8_linkage@ IMPORTED)
    set_target_properties(V8::${_component} PROPERTIES
      IMPORTED_CONFIGURATIONS "Release;Debug"
      IMPORTED_LOCATION_RELEASE "${_v8_root}/@runtime_subdir@/${_filename}"
      IMPORTED_LOCATION_DEBUG "${_v8_root}/debug/@runtime_subdir@/${_filename}"
      MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
      MAP_IMPORTED_CONFIG_MINSIZEREL Release
      INTERFACE_COMPILE_FEATURES cxx_std_20
      INTERFACE_COMPILE_DEFINITIONS "V8_GN_HEADER;V8_COMPRESS_POINTERS=1;V8_ENABLE_SANDBOX=1"
      INTERFACE_INCLUDE_DIRECTORIES "${_v8_root}/include;$<$<CONFIG:Debug>:${_v8_root}/debug/include>;$<$<NOT:$<CONFIG:Debug>>:${_v8_root}/release/include>")
    if(WIN32 AND V8_LINKAGE STREQUAL "SHARED")
      set_target_properties(V8::${_component} PROPERTIES
        IMPORTED_IMPLIB_RELEASE "${_v8_root}/lib/${_filename}.lib"
        IMPORTED_IMPLIB_DEBUG "${_v8_root}/debug/lib/${_filename}.lib")
      set_property(TARGET V8::${_component} APPEND PROPERTY INTERFACE_COMPILE_OPTIONS /Zc:__cplusplus)
    endif()
  endforeach()
  if(V8_LINKAGE STREQUAL "SHARED")
    set_property(TARGET V8::V8 APPEND PROPERTY INTERFACE_LINK_LIBRARIES V8::Platform V8::Base)
    set_property(TARGET V8::V8 APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS
      USING_V8_SHARED=1 USING_V8_SHARED_PRIVATE=1 USING_V8_PLATFORM_SHARED=1 USING_V8_BASE_SHARED=1)
    set_property(TARGET V8::Platform APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS USING_V8_PLATFORM_SHARED=1)
    set_property(TARGET V8::Base APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS USING_V8_BASE_SHARED=1)
  elseif(APPLE)
    set_property(TARGET V8::V8 APPEND PROPERTY INTERFACE_LINK_LIBRARIES "-framework CoreFoundation")
  endif()
endif()
unset(_v8_root)
unset(_components)
unset(_component)
unset(_filename)
unset(_config)
unset(_dir)
