# Verify the packaged headers and CMake target without a vcpkg toolchain.
function(star_test_gsl target sdk)
  find_package(Microsoft.GSL CONFIG REQUIRED
    PATHS "${sdk}/share/Microsoft.GSL" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
  get_target_property(kind Microsoft.GSL::GSL TYPE)
  if(NOT kind STREQUAL "INTERFACE_LIBRARY")
    message(FATAL_ERROR "Expected header-only Microsoft GSL")
  endif()
  get_target_property(includes Microsoft.GSL::GSL INTERFACE_INCLUDE_DIRECTORIES)
  foreach(path IN LISTS includes)
    cmake_path(IS_PREFIX sdk "${path}" NORMALIZE from_sdk)
    if(NOT from_sdk OR NOT EXISTS "${path}/gsl/assert")
      message(FATAL_ERROR "Microsoft GSL resolved outside the SDK or is missing: ${path}")
    endif()
  endforeach()
  if(NOT EXISTS "${sdk}/share/ms-gsl/copyright")
    message(FATAL_ERROR "SDK is missing the Microsoft GSL license")
  endif()
  target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/gsl.cpp")
  target_link_libraries(${target} PRIVATE Microsoft.GSL::GSL)
endfunction()
